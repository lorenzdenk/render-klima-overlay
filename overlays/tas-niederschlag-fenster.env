# Tasmanien: Niederschlag im Fenster 20.11.-07.12.
# = gewichtetes Mittel der Monatssummen Nov (11 Tage im Fenster) und Dez (7 Tage), Einheit mm pro Monat.
# Layernamen erst nach dem Lauf von "Prepare Tasmania LIST climate" eintragen (siehe Branch prepare-logs, coverages.txt).
NAME=tasmanien-niederschlag-20nov-07dez
TITLE="Tasmanien: Niederschlag 20.11.–07.12."
RELEASE=klima-tasmanien
DATA_RELEASE=tas-list-daten
INPUTS="RAIN_NOV.tif RAIN_DEC.tif"
WEIGHTS="11 7"
OP=mean
UNIT="mm/Monat"
CMAP=YlGnBu
VMIN=20
VMAX=250
GAMMA=0.7
MINZOOM=5
MAXZOOM=11
QUALITY=90
DESCRIPTION="Mittlere Monatssumme Niederschlag, gewichtetes Mittel (11:7) der Monatsmittel Nov/Dez aus den Digital Climate Maps of Tasmania (theLIST, 30 m, heutiges Klima bis 2018), stellvertretend für 20.11.–07.12."
ATTRIBUTION="Digital Climate Maps of Tasmania, theLIST © State of Tasmania, Daten geändert"
