# Tasmanien: mittlere Tiefsttemperatur 20.11.–07.12. aus ANUClimate (zum Vergleich mit tas-tmin-fenster aus theLIST)
# = gewichtetes Mittel (11:7) der Monatsmittel Nov/Dez 1991–2020; gleiche Farbskala wie tas-tmin-fenster.
# Quelldaten: Workflow "Prepare ANUClimate" -> Release anu-daten.
NAME=tasmanien-anu-tmin-20nov-07dez
TITLE="Tasmanien: mittlere Tmin 20.11.–07.12. (ANUClimate)"
RELEASE=klima-tasmanien
DATA_RELEASE=anu-daten
INPUTS="anu_tmin_1991-2020_11.tif anu_tmin_1991-2020_12.tif"
WEIGHTS="11 7"
OP=mean
UNIT="°C"
CMAP=RdYlBu_r
VMIN=2
VMAX=13
GAMMA=1
MINZOOM=5
MAXZOOM=11
# 1-km-Zellen: nativ Zoom 6 (512-px-Kacheln), eine Stufe mehr, damit die Zellen als Blöcke erscheinen
EXTRA_ZOOM=1
QUALITY=90
LABELS=1
LABEL_SUFFIX=°
LABEL_DECIMALS=1
LABEL_GRID=10
LABEL_MINZOOM=6
LABEL_MIN_COVER=0.3
DESCRIPTION="Mittlere tägliche Tiefsttemperatur 20.11.–07.12., gewichtetes Mittel (11:7) der Monatsmittel Nov/Dez 1991–2020 aus ANUClimate (ANU/NCI, 0,01°)"
ATTRIBUTION="ANUClimate, Australian National University / NCI, Daten geändert"
