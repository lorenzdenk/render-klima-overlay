# Tasmanien: mittlere Tiefsttemperatur im Fenster 20.11.-07.12.
# = gewichtetes Mittel der Monatsraster Nov (11 Tage im Fenster) und Dez (7 Tage).
NAME=tasmanien-tmin-20nov-07dez
TITLE="Tasmanien: mittlere Tmin 20.11.–07.12."
RELEASE=klima-tasmanien
DATA_RELEASE=tas-list-daten
INPUTS="min_avg_nov.tif min_avg_dec.tif"
WEIGHTS="11 7"
OP=mean
UNIT="°C"
CMAP=RdYlBu_r
# Quellwerte: Nov 1,5–12,4 °C, Dez 2,5–13,7 °C
VMIN=2
VMAX=13
GAMMA=1
MINZOOM=5
MAXZOOM=11
QUALITY=90
DESCRIPTION="Mittlere tägliche Tiefsttemperatur 20.11.–07.12., gewichtetes Mittel (11:7) der Monatsmittel Nov/Dez aus den Digital Climate Maps of Tasmania (theLIST, 30 m, heutiges Klima bis 2018)"
ATTRIBUTION="Digital Climate Maps of Tasmania, theLIST © State of Tasmania, Daten geändert"
