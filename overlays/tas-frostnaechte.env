# Tasmanien: Anzahl Nächte pro Jahr mit Tmin < 1 °C im Zeitraum 25.11.–31.12.
# Quell-Layer Climate:fr_lt1_2511to3112 (theLIST Digital Climate Maps, Frostrisiko nach Webb et al. 2017), unverändert.
NAME=tasmanien-naechte-unter-1grad-25nov-31dez
TITLE="Tasmanien: Nächte unter 1 °C, 25.11.–31.12."
RELEASE=klima-tasmanien
DATA_RELEASE=tas-list-daten
INPUTS="fr_lt1_2511to3112.tif"
WEIGHTS="1"
OP=mean
UNIT="Nächte/Jahr"
CMAP=YlGnBu
VMIN=0
VMAX=20
GAMMA=0.6
MINZOOM=5
MAXZOOM=11
QUALITY=90
# Auf der höchsten Zoomstufe den Mittelwert jeder Kachel (ca. 14 × 14 km) als Zahl in die Mitte schreiben
LABELS=1
LABEL_SUFFIX=
DESCRIPTION="Mittlere Anzahl Nächte pro Jahr mit Tiefsttemperatur unter 1 °C zwischen 25.11. und 31.12. (37 Tage), aus den Digital Climate Maps of Tasmania (theLIST, 30 m, Layer fr_lt1_2511to3112)"
ATTRIBUTION="Digital Climate Maps of Tasmania, theLIST © State of Tasmania, Daten geändert"
